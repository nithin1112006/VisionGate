# ==============================================================================
# VisionGate / Attenda - Centralized Production Environment Configuration
# Copy this file to .env and configure values before deploying:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Database name, credentials, and network settings
PG_DB=attenda
PG_USER=attenda
PG_PASSWORD=attenda_secure_password_change_in_production
PG_HOST=postgres
PG_PORT=5432
PG_HOST_PORT=5434
PG_POOL_MIN_SIZE=5
PG_POOL_MAX_SIZE=40

# ------------------------------------------------------------------------------
# 2. Application Server & Ports
# ------------------------------------------------------------------------------
# Port for Nginx public ingress (HTTP)
HTTP_PORT=80

# Port for FastAPI direct backend API
BACKEND_PORT=8001

# Application environment (production / development)
APP_ENV=production
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 3. Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Strong random secret key for JWT session tokens
JWT_SECRET=visiongate_production_secret_key_change_me_random_64_chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# 4. Hardware Acceleration & GPU Settings
# ------------------------------------------------------------------------------
# NVIDIA GPU passthrough settings (all = use all available GPUs)
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ------------------------------------------------------------------------------
# 5. Cloudflare Edge & Zero-Trust Tunnel Integration
# ------------------------------------------------------------------------------
# If deploying behind Cloudflare Zero-Trust Tunnel, paste your Tunnel Token:
CLOUDFLARE_TUNNEL_TOKEN=

# Public domain name pointing to this server (e.g. attenda.yourcollege.edu):
CLOUDFLARE_DOMAIN=attenda.example.com

# ------------------------------------------------------------------------------
# 6. Backup & Retention Policies
# ------------------------------------------------------------------------------
# Number of daily database backups to retain before automated cleanup
BACKUP_RETENTION_DAYS=14
