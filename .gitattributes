# Auto detect text files and perform LF normalization
* text=auto

# Enforce Unix LF line endings on scripts, configs, and containers
*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
.env* text eol=lf
